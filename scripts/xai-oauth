#!/usr/bin/env python3
"""xAI OAuth helper for anthroxy `credential.kind = "command"` / `output = "json"`.

login  — device-code flow; writes ~/.config/anthroxy/xai-oauth.json (0600)
print  — refresh if needed; stdout is {"token": "...", "expires_at": "..."}

stderr is for humans. print writes one JSON object to stdout and nothing else.
"""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

CLIENT_ID = "b1a00492-073a-47ea-816f-4c329264a828"
DEVICE_URL = "https://auth.x.ai/oauth2/device/code"
TOKEN_URL = "https://auth.x.ai/oauth2/token"
SCOPE = "openid profile email offline_access grok-cli:access api:access"
REFRESH_MARGIN_S = 120
VERSION = 1


def default_store() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME")
    if base:
        return Path(base) / "anthroxy" / "xai-oauth.json"
    return Path.home() / ".config" / "anthroxy" / "xai-oauth.json"


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def post_form(url: str, fields: dict[str, str], timeout: float = 30.0) -> tuple[int, str]:
    body = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.getcode(), resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(errors="replace")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        die(f"request to {url} failed: {e}")


def parse_json(text: str, what: str) -> dict:
    try:
        value = json.loads(text)
    except json.JSONDecodeError as e:
        die(f"{what} is not JSON: {e}")
    if not isinstance(value, dict):
        die(f"{what} is not an object")
    return value


def expires_at_from_expires_in(expires_in: int) -> str:
    when = datetime.now(timezone.utc) + timedelta(seconds=int(expires_in))
    return when.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_expires_at(text: str) -> datetime | None:
    raw = text.strip()
    if raw.endswith("Z"):
        raw = raw[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(raw)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def load_store(path: Path) -> dict:
    if not path.is_file():
        die(f"{path} does not exist; run: {sys.argv[0]} login")
    try:
        record = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as e:
        die(f"cannot read {path}: {e}")
    if not isinstance(record, dict):
        die(f"{path} is not a JSON object")
    if record.get("version") != VERSION:
        die(f"{path} is store version {record.get('version')!r}, not {VERSION}")
    if not record.get("access_token"):
        die(f"{path} has an empty access_token")
    return record


def save_store(path: Path, record: dict) -> None:
    path = path.expanduser()
    parent = path.parent
    if parent.as_posix() not in ("", "."):
        parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            os.chmod(parent, 0o700)
        except OSError:
            pass
    payload = json.dumps(record, indent=2, sort_keys=True) + "\n"
    fd, tmp = tempfile.mkstemp(prefix=".xai-oauth.", dir=str(parent if parent.as_posix() not in ("", ".") else "."))
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(payload)
        os.chmod(tmp, stat.S_IRUSR | stat.S_IWUSR)
        os.replace(tmp, path)
        os.chmod(path, stat.S_IRUSR | stat.S_IWUSR)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        die(f"cannot write {path}: {e}")


def needs_refresh(record: dict, now: datetime) -> bool:
    refresh = record.get("refresh_token") or ""
    if not refresh:
        return False
    text = record.get("expires_at")
    if not text:
        return True
    expires = parse_expires_at(str(text))
    if expires is None:
        return True
    return expires - timedelta(seconds=REFRESH_MARGIN_S) <= now


def apply_token_response(record: dict, body: dict, token_url: str, client_id: str) -> None:
    access = body.get("access_token")
    if not isinstance(access, str) or not access:
        die("token endpoint returned an empty access_token")
    record["access_token"] = access
    rt = body.get("refresh_token")
    if isinstance(rt, str) and rt:
        record["refresh_token"] = rt
    expires_in = body.get("expires_in")
    if isinstance(expires_in, (int, float)) and expires_in > 0:
        record["expires_at"] = expires_at_from_expires_in(int(expires_in))
    record["token_endpoint"] = token_url
    record["client_id"] = client_id
    record["version"] = VERSION


def refresh(record: dict, token_url: str, client_id: str) -> None:
    rt = record.get("refresh_token") or ""
    if not rt:
        die("store has no refresh_token; run login")
    status, text = post_form(
        token_url,
        {
            "grant_type": "refresh_token",
            "refresh_token": rt,
            "client_id": client_id,
        },
    )
    if status < 200 or status >= 300:
        die(f"token refresh rejected: HTTP {status}: {text[:300]}")
    apply_token_response(record, parse_json(text, "token refresh"), token_url, client_id)


def cmd_login(args: argparse.Namespace) -> None:
    client_id = args.client_id
    device_url = args.device_url
    token_url = args.token_url
    status, text = post_form(
        device_url,
        {"client_id": client_id, "scope": SCOPE},
    )
    if status < 200 or status >= 300:
        die(f"device-code request rejected: HTTP {status}: {text[:300]}")
    device = parse_json(text, "device-code response")
    user_code = device.get("user_code")
    verification = device.get("verification_uri")
    complete = device.get("verification_uri_complete")
    device_code = device.get("device_code")
    if not isinstance(user_code, str) or not isinstance(verification, str) or not isinstance(device_code, str):
        die("device-code response missing user_code, verification_uri or device_code")
    interval = device.get("interval")
    if not isinstance(interval, int) or interval < 0:
        interval = 5
    expires_in = device.get("expires_in")
    if not isinstance(expires_in, int) or expires_in < 1:
        expires_in = 300
    print(f"Open {verification} and enter code {user_code}", file=sys.stderr)
    if isinstance(complete, str) and complete:
        print(f"or open {complete}", file=sys.stderr)
    deadline = time.monotonic() + expires_in
    wait = float(interval)
    while time.monotonic() < deadline:
        time.sleep(wait)
        status, text = post_form(
            token_url,
            {
                "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                "device_code": device_code,
                "client_id": client_id,
            },
        )
        if 200 <= status < 300:
            body = parse_json(text, "token response")
            record = {
                "version": VERSION,
                "access_token": "",
                "refresh_token": None,
            }
            apply_token_response(record, body, token_url, client_id)
            save_store(args.store, record)
            print(f"wrote {args.store}", file=sys.stderr)
            return
        err = parse_json(text, "token error") if text.strip().startswith("{") else {}
        name = err.get("error") if isinstance(err.get("error"), str) else ""
        if name == "authorization_pending":
            continue
        if name == "slow_down":
            wait += 5
            continue
        if name in ("expired_token", "access_denied"):
            die(f"device login {name}")
        die(f"device login rejected: HTTP {status}: {text[:300]}")
    die("device code expired before approval")


def cmd_print(args: argparse.Namespace) -> None:
    record = load_store(args.store)
    client_id = args.client_id or record.get("client_id") or CLIENT_ID
    if args.token_url_explicit:
        token_url = args.token_url
    elif isinstance(record.get("token_endpoint"), str) and record["token_endpoint"]:
        token_url = record["token_endpoint"]
    else:
        token_url = args.token_url
    now = datetime.now(timezone.utc)
    if needs_refresh(record, now):
        try:
            refresh(record, token_url, client_id)
            save_store(args.store, record)
        except SystemExit:
            expires = parse_expires_at(str(record.get("expires_at") or ""))
            if expires is None or expires <= now:
                raise
            print("token refresh failed; serving stored access token", file=sys.stderr)
    token = record.get("access_token")
    if not isinstance(token, str) or not token:
        die("access token is empty")
    out = {"token": token}
    if record.get("expires_at"):
        out["expires_at"] = record["expires_at"]
    sys.stdout.write(json.dumps(out, separators=(",", ":")))
    sys.stdout.write("\n")


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description="xAI OAuth helper for anthroxy command credentials",
    )
    parser.add_argument(
        "--store",
        type=Path,
        default=default_store(),
        help="token file (default: $XDG_CONFIG_HOME/anthroxy/xai-oauth.json)",
    )
    parser.add_argument("--token-url", default=TOKEN_URL, help="token endpoint")
    parser.add_argument("--device-url", default=DEVICE_URL, help="device-code endpoint")
    parser.add_argument("--client-id", default=CLIENT_ID, help="public Grok CLI client id")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("login", help="device-code login; write the store")
    sub.add_parser("print", help="refresh if needed; print JSON token on stdout")
    args = parser.parse_args(argv)
    args.token_url_explicit = "--token-url" in (argv if argv is not None else sys.argv[1:])
    args.store = args.store.expanduser()
    if args.command == "login":
        cmd_login(args)
    else:
        cmd_print(args)


if __name__ == "__main__":
    main()
